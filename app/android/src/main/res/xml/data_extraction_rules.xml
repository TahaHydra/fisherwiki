<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup is disabled for everything. The catch log may contain fishing
  locations, and a privacy-first app should not ship them to a backup service
  the user did not think about. Local device-to-device transfer is likewise
  excluded to keep one simple rule: this data stays where the user put it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
